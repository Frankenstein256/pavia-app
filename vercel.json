{
  "buildCommand": "pnpm install --frozen-lockfile && pnpm --filter @workspace/fundi run build",
  "outputDirectory": "artifacts/fundi/dist/public",
  "installCommand": "pnpm install --frozen-lockfile",
  "framework": null,
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "build": {
    "env": {
      "BASE_PATH": "/",
      "PORT": "3000",
      "NODE_ENV": "production"
    }
  }
}
